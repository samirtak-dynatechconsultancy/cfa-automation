# Copy to .env and fill in. NEVER commit real values.

# --- Microsoft Graph (app-only / client credentials) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional overrides (defaults are fine):
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# --- Settings store: a SharePoint List on this site (auto-created) ---
# Provide the site URL only. The list is created automatically if missing.
# Leave blank to run without persisted admin defaults (in-memory only).
SETTINGS_SITE_URL=
SETTINGS_LIST_NAME=CFA App Settings
# Run history list (create it manually in SharePoint on the same site):
RUNS_LIST_NAME=CFA App Runs

# --- Service ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
