# Normalize line endings; treat these as text.
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf

# Binary (never diff/normalize) — although these are gitignored, be safe.
*.xlsx  binary
*.xlsm  binary
*.xls   binary
